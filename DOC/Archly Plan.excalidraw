      "updated": 1781464141392,
      "link": null,
      "locked": false,
      "text": "| No | API Route | Method | Description |\n    |-----|-----------|--------|-------------|\n    | 1 | /api/auth/signup | POST | Register new user |\n    | 2 | /api/auth/login | POST | Login user |\n    | 3 | /api/auth/me | GET | Get current user |\n    | 4 | /api/blogs | POST | Create a blog |\n    | 5 | /api/blogs | GET | Fetch all blogs |\n    | 6 | /api/blogs/:id | GET | Fetch single blog |\n    | 7 | /api/blogs/my-blogs/:id | GET | Fetch user blogs |\n    | 8 | /api/blogs/like | POST | Like / dislike blog |\n    | 9 | /api/blogs/save | POST | Save a blog |\n    | 10 | /api/blogs/search?q= | GET | Search blogs |",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "wSRytpUPtqW8K4TsbfPJO",
      "originalText": "| No | API Route | Method | Description |\n    |-----|-----------|--------|-------------|\n    | 1 | /api/auth/signup | POST | Register new user |\n    | 2 | /api/auth/login | POST | Login user |\n    | 3 | /api/auth/me | GET | Get current user |\n    | 4 | /api/blogs | POST | Create a blog |\n    | 5 | /api/blogs | GET | Fetch all blogs |\n    | 6 | /api/blogs/:id | GET | Fetch single blog |\n    | 7 | /api/blogs/my-blogs/:id | GET | Fetch user blogs |\n    | 8 | /api/blogs/like | POST | Like / dislike blog |\n    | 9 | /api/blogs/save | POST | Save a blog |\n    | 10 | /api/blogs/search?q= | GET | Search blogs |",
      "autoResize": true,
      "lineHeight": 1.25
    },
